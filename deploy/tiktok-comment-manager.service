[Unit]
Description=TikTok Comment Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/tiktok-comment-manager
EnvironmentFile=/etc/default/tiktok-comment-manager
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tiktok-comment-manager/data

[Install]
WantedBy=multi-user.target