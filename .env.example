# Copy this file to `.env` and fill in real values.

# Client key from your TikTok Developer App (https://developers.tiktok.com/).
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here

# Client secret from your TikTok Developer App.
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here

# Public base URL of this app. The OAuth redirect URI configured in your TikTok
# app must exactly match `${APP_URL}/auth/tiktok/callback`.
# For local development this is typically http://localhost:3000.
APP_URL=http://localhost:3000

# Port the Express server listens on.
PORT=3000

# 32-byte (64 hex character) key used to AES-256-GCM encrypt access/refresh
# tokens stored at rest in data/accounts.json.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64_hex_characters_generated_via_crypto_randomBytes_32

# Secret used to sign user session JWTs. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_for_signing_user_sessions

# How long a user session stays valid (in days). Defaults to 7.
SESSION_TTL_DAYS=7
